{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true
  },
  "include": ["web/**/*.js", "web/**/*.d.ts"],
  "exclude": ["web/data/**", "web/sw.js"]
}
