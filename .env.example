# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
#
# AWS
# make deploy-staging / promote / rollback need these two:
# BUCKET=<s3-bucket-name>
# CF_DISTRIBUTION_ID=<production-cloudfront-distribution-id>
#
# make test-staging / test-staging-full need this one — it is only used to
# build BASE_URL for Playwright:
# STAGING_DOMAIN=<staging-domain>
#
# Not read by anything today. Staging freshness comes from short cache-control
# headers set during deploy-staging, not from an invalidation, so there is no
# call site for it. Kept because it is worth recording alongside the rest.
# STAGING_CF_ID=<staging-cloudfront-distribution-id>

# Cloudflare — DNS management (optional, one-time setup)
# CLOUDFLARE_API_TOKEN=<api-token>
#
# No API keys are currently required. KJV scripture is bundled.
# NRSVUE is not distributable — if you have a local copy or use
# the nrsvue-source tool, place files at data/translations/nrsvue/.
