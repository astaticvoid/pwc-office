# OS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo

# Source documents — copyrighted, obtain separately
sources/*
!sources/bas_short_*.csv

# Errata source documents — reproduce the corrected liturgical text in full,
# same class of copyrighted artifact as sources/*.pdf (ADR 0021, #86).
# docs/errata/README.md (our own writing: rulings, word-level quotes) stays.
docs/errata/ordinary-time.md
docs/errata/seasonal.md

# All data/ content is copyrighted or derived from copyrighted sources — not for distribution.
# Exception: KJV translation is public domain and committed.
# Exception: corrections.json is the single versioned correction manifest (ADR 0005) —
#   supersedes patches.json, which is deleted (was unused; see issue #14).
data/*
!data/translations/
data/translations/*
!data/translations/kjv/
!data/corrections.json
!data/paragraphs.json

boneyard/data/

# Local secrets — never commit
.env
*.p8

# Python virtualenv — created by `make venv`
.venv/

# Ruff cache — linter local state
.ruff_cache/

# Generated pipeline artifacts and baselines — never published, always re-derivable
.build/

# Claude Code — machine-local settings only; shared settings (.claude/settings.json etc.) are tracked
.claude/settings.local.json

# Agent scratch space — one-off scripts generated during AI-assisted sessions
scratch/
patch_*.py
patch_*.cjs
patch_*.js
split_*.py

# pi — local tool config and prompts
.pi/

# Design scratch space — docs/ is the tracked home for design docs
redesign/

# Dead code kept for local reference
boneyard/

# Local Netlify folder
.netlify

# Generated build output — produced by `make build`, never committed
dist/

# Capacitor — native build artifacts (ios/ and android/ source is tracked; build outputs excluded)
ios/App/Pods/
ios/App/.build/
ios/App/App.xcworkspace/xcuserdata/
ios/App/xcuserdata/
android/.gradle/
android/build/
android/app/build/
android/local.properties
# Generated web assets synced into native projects by `npx cap sync` — contain copyrighted data
ios/App/App/public/
android/app/src/main/assets/public/

# Node / Playwright
node_modules/
playwright-report/
test-results/

# Golden snapshot files — derived from copyrighted liturgical content, not for distribution
e2e/testdata/

# Scraper caches — local state, not committed
tools/.scrape_cache.json
tools/.daily_cache/

# Generated audit artefacts — CLI run outputs and comparison reports
audit/
tools/extract_audit_report.txt
.deploy-latest
.staging-tested
.server-pid
